{
  "name": "microbit-sensor-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "typecheck": "tsc --project jsconfig.json",
    "test:browser": "node scripts/dev.mjs --browser-tests",
    "test:e2e": "playwright test --grep-invert @large",
    "test:e2e:ui": "playwright test --grep-invert @large",
    "test:e2e:large": "playwright test --grep \"@large$\"",
    "test:e2e:large-import": "playwright test --grep @large-import",
    "test:e2e:all": "playwright test",
    "build": "node scripts/build.mjs",
    "build:firmware": "node dev/firmware/build.mjs",
    "check:firmware": "node --test tests/unit/firmware.test.mjs tests/unit/sensor-display.test.mjs",
    "publish:firmware": "node dev/firmware/publish.mjs",
    "test:e2e:build": "playwright test --config playwright.build.config.mjs",
    "test:e2e:cloudflare": "playwright test --config playwright.cloudflare.config.mjs",
    "build:math": "node dev/math/build.mjs"
  },
  "devDependencies": {
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "nrf-intel-hex": "1.4.0",
    "pretendard": "1.3.9",
    "typescript": "5.9.3",
    "wrangler": "4.155.0"
  }
}
