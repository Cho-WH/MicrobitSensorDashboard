{
  "name": "microbit-sensor-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "typecheck": "tsc --project jsconfig.json",
    "test:browser": "node scripts/dev.mjs --browser-tests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --grep-invert @large",
    "test:e2e:large": "playwright test --grep @large",
    "build": "node scripts/build.mjs",
    "build:firmware": "node dev/firmware/build.mjs",
    "check:firmware": "node --test tests/unit/firmware.test.mjs tests/unit/sensor-display.test.mjs",
    "publish:firmware": "node dev/firmware/publish.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "nrf-intel-hex": "1.4.0",
    "typescript": "5.9.3"
  }
}
